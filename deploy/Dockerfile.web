# Dashboard (static build) served by Caddy, which also proxies /api to the API.
FROM node:22-bookworm-slim AS build
WORKDIR /frontend
COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci
COPY frontend/ ./
# same-origin: the bundle calls the host it was loaded from, so one image works behind
# a domain, a Tailscale name or a bare IP. The token is compiled into the bundle.
ARG VITE_API_TOKEN=""
ENV VITE_API_URL=same-origin \
    VITE_API_TOKEN=${VITE_API_TOKEN}
RUN npm run build

FROM caddy:2-alpine
COPY deploy/Caddyfile /etc/caddy/Caddyfile
COPY --from=build /frontend/dist /srv
