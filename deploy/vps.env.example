# ../.env on the VPS — the app's settings. Copy from here, not from the workstation:
# the workstation .env holds keys (LLM) and research settings this server has no use for.

# Only the live paper terminal runs here; research/ingest/ML/settings writes are refused.
LAB_ROLE=paper
TRADING_MODE=paper
LIVE_ENABLED=false

# The ledger survives deploys and reboots; unfinished sessions resume on start.
# One journal per session goes to data/paper/sessions/ (next to this file).
LIVE_PAPER_JOURNAL=data/paper/live_events.jsonl
# One journal per session. Empty would be derived as `sessions/` next to the journal above;
# spelled out because an `.env` missing this (and the portfolio) is the documented cause of
# `live paper boot: idle` with journals sitting on disk (docs/26 §8).
LIVE_PAPER_SESSIONS_DIR=data/paper/sessions
# Sessions to run, reconciled by name on every start (see the file's header).
# When set, it replaces LIVE_PAPER_AUTOSTART and the LIVE_PAPER_ROBOT/SYMBOL/INTERVAL below.
LIVE_PAPER_PORTFOLIO=deploy/paper_portfolio.yaml
LIVE_PAPER_MAX_SESSIONS=8
LIVE_PAPER_MAX_FEEDS=5
LIVE_PAPER_AUTOSTART=true
LIVE_PAPER_SYMBOL=ETHUSDT
LIVE_PAPER_INTERVAL=1h
# Live terminal robots: regime | ema | adaptive_ema | vpin_momentum | formulaic_lgbm
LIVE_PAPER_ROBOT=regime
LIVE_PAPER_STARTING_EQUITY=10000
LIVE_PAPER_TAKE_PROFIT_MULTIPLE=2

# Frozen research configuration the robot trades with. Copy these values from the
# workstation run you want to rehearse, and change them only by redeploying: a running
# session keeps the configuration it started with, because that configuration is written
# into its journal (Stop + a new name to change it).
#
# What actually reaches the live session (api/live_paper_boot.py::live_config_from_settings):
# RISK_PER_TRADE, STOP_PCT, LIVE_PAPER_TAKE_PROFIT_MULTIPLE, FAST_EMA/SLOW_EMA,
# regime_params(), adaptive_ema_params(), MAX_DAILY_LOSS, MAX_DRAWDOWN and the fee
# schedules. Everything else in .env is research-only (see the note at the end).
RISK_PER_TRADE=0.005
STOP_PCT=0.01
MAX_DAILY_LOSS=0.02
# No cooldown in the live terminal: once tripped, the session opens no new positions for
# the rest of its life (exits keep working). Fail closed, and visible in `risk_refusals`.
MAX_DRAWDOWN=0.06
# Fees come ONLY from these four (domain/fees.py). MAKER_FEE/TAKER_FEE are NOT Settings
# fields: pydantic's extra="ignore" drops them silently, so a file carrying them looks
# configured while the session pays whatever SPOT_* says. ETHUSDT/BTCUSDT are spot.
SPOT_MAKER_FEE=0.00075
SPOT_TAKER_FEE=0.00075
USDM_MAKER_FEE=0.0002
USDM_TAKER_FEE=0.0005
FAST_EMA=10
SLOW_EMA=20
# Dead band of the `ema` robot: a cross closer than this fraction of price is not a
# signal (`EmaCrossover.min_spread_pct`). 0 = every cross trades.
EMA_MIN_SPREAD_PCT=0
# Regime legs that may open positions ("" = all three). Reaches the live
# `regime`/`adaptive_ema` router; per-session files override it with `legs:`.
REGIME_LEGS=
ER_PERIOD=20
TREND_EMA_PERIOD=40
SLOPE_LOOKBACK=10
ENTER_TREND_ER=0.30
EXIT_TREND_ER=0.20
DONCHIAN_PERIOD=20
BB_PERIOD=20
BB_K=2
# These three travel through RegimeParams into the live session, and the CODE DEFAULT for
# range_allow_short is `true` — a range leg that shorts the upper band. Omitting them here
# therefore trades a different rulebook than an H3 research run (docs/32 §2), so they are
# spelled out rather than left to the defaults.
REGIME_CONFIRMATION_BARS=1
REGIME_RANGE_ALLOW_SHORT=false
REGIME_MIN_HOLD_BARS=0

# Dashboard gate. Origin = exactly how you open the dashboard in the browser:
#   http://100.101.102.103  (Tailscale IP)   or   https://lab.example.com
API_ALLOWED_ORIGINS=http://100.101.102.103
# Long random string: openssl rand -hex 32   (the same value in deploy/.env API_TOKEN -
# it is compiled into the dashboard bundle, so changing it needs `up -d --build`, not restart)
API_TOKEN=

# Tick collector writes here (catalog/data/agg_trade/<SYMBOL>/<day>.parquet).
CATALOG_PATH=catalog

# Alerts: the watchdog (api/health.py) sends a message when a feed goes silent, a
# session's journal stops writing or a circuit breaker trips, and again on recovery;
# plus one message per start. Strongly recommended for a server nobody watches.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
LIVE_PAPER_WATCHDOG_SECONDS=30
LIVE_PAPER_FEED_TIMEOUT_SECONDS=90
# Dead-man's switch: a push check (healthchecks.io, Uptime Kuma "push"). Pinged every
# HEARTBEAT_SECONDS while /readyz is green; the service alarms when pings stop - the
# only alert that still works when this VPS itself is down. Period ~5 min, grace ~10.
LIVE_PAPER_HEARTBEAT_URL=
LIVE_PAPER_HEARTBEAT_FAIL_URL=
LIVE_PAPER_HEARTBEAT_SECONDS=300

# Decision Log for Live Paper API (persisted to writable data volume)
DECISION_LOG_ENABLED=true
DECISION_LOG_DIR=data/paper/decisions
DECISION_LOG_RETENTION_DAYS=3
DECISION_LOG_MAX_MB=500

# --- Data quality / nightly refresh (docs/34 P2) -------------------------------------
# A catalog series whose QC verdict is `fail` is refused by every backtest.
# true only to study the defect itself.
ALLOW_FAILED_DATA=false

# --- What this file deliberately does NOT set ----------------------------------------
# The server only runs the live paper terminal (LAB_ROLE=paper); research settings stay in
# the workstation .env, where the runs happen.
#   LLM_*                 the offline `lab propose` loop - refused with 403 on this server,
#                         and an LLM key has no business on a trading VPS.
#   EXCHANGE_API_*        Settings never reads them; no exchange keys are needed at all.
#   MAKER_FEE/TAKER_FEE   not Settings fields (see the fee schedules above).
#   FORMULAIC_/META_LABEL_/ML_OBI_MODEL_PATH   models/ is not in the image, so such a
#                         session would fail closed instead of trading a fallback model.
#   VPIN_BUCKET_VOLUME, VPIN_TOXIC_THRESHOLD, FORMULAIC_THRESHOLD,
#   META_LABEL_THRESHOLD   hard-coded in api/paper_streamer.py: set them and the live
#                         session ignores them (docs/26 §1).
#   ENTRY_FILTER_*, NO_INSTANT_REVERSE, PAIRS_*, FUNDING_*, SELECTION_METRIC,
#   EMBARGO_BARS, TRIALS_LEDGER_PATH   research/backtest configuration only (docs/31 §7).

