# Default is research/backtest. Never put real keys in git.
TRADING_MODE=research
LIVE_ENABLED=false

# Starting simulated equity for research backtests (quote currency).
STARTING_EQUITY=100000

# Risk limits (fractions of equity). Override only with intent.
RISK_PER_TRADE=0.005
STOP_PCT=0.01
MAX_DAILY_LOSS=0.02
MAX_DRAWDOWN=0.06
MAX_OPEN_POSITIONS=1

# regime | ema | pairs | funding | ml_obi | glft | tri_scan
ROBOT=regime

# EMA robot (used when ROBOT=ema).
FAST_EMA=10
SLOW_EMA=20

# Regime classifier (Kaufman ER + EMA slope) and per-regime strategies.
ER_PERIOD=20
TREND_EMA_PERIOD=40
SLOPE_LOOKBACK=10
ENTER_TREND_ER=0.30
EXIT_TREND_ER=0.20
DONCHIAN_PERIOD=20
BB_PERIOD=20
BB_K=2

# Leave empty. Live execution is not wired and will fail closed.
EXCHANGE_API_KEY=
EXCHANGE_API_SECRET=

# Nautilus Parquet catalog of public Binance ETH/USDT klines (research only).
CATALOG_PATH=catalog
BAR_INTERVAL=1h
BINANCE_SYMBOL=ETHUSDT
# Comma-separated symbols for multi-instrument ingest (BTCUSDT,ETHUSDT)
BINANCE_SYMBOLS=["ETHUSDT","BTCUSDT"]
EMBARGO_BARS=10
USE_BAR_VPIN=false
MAKER_FEE=0.001
TAKER_FEE=0.001
KELLY_FRACTION=0.25
MAX_VAR_99=0.05
# Optional alerts (Telegram or webhook for Slack/Discord)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
ALERT_WEBHOOK_URL=
