# Default is research/backtest. Never put real keys in git.
TRADING_MODE=research
LIVE_ENABLED=false

# Starting simulated equity for research backtests (quote currency).
STARTING_EQUITY=100000

# Risk limits (fractions of equity). Override only with intent.
RISK_PER_TRADE=0.005
STOP_PCT=0.01
MAX_DAILY_LOSS=0.02
MAX_DRAWDOWN=0.06
MAX_OPEN_POSITIONS=1

# regime | ema | pairs | vpin_momentum | formulaic_lgbm | meta_label | adaptive_ema
ROBOT=regime

# EMA robot (used when ROBOT=ema).
FAST_EMA=10
SLOW_EMA=20

# Regime classifier (Kaufman ER + EMA slope) and per-regime strategies.
ER_PERIOD=20
TREND_EMA_PERIOD=40
SLOPE_LOOKBACK=10
ENTER_TREND_ER=0.30
EXIT_TREND_ER=0.20
DONCHIAN_PERIOD=20
BB_PERIOD=20
BB_K=2

# adaptive_ema robot: the regime filter's EMA step depends on the efficiency ratio.
# ADAPTIVE_SELECTIVITY=0 disables that (α becomes constant = the `regime` filter), so
# the grid {10,20,40} x {0,0.5,1} contains its own control.
ADAPTIVE_PERIOD=40
ADAPTIVE_ER_PERIOD=20
ADAPTIVE_SELECTIVITY=0.5
ADAPTIVE_SLOPE_LOOKBACK=10

# Leave empty. Live execution is not wired and will fail closed.
EXCHANGE_API_KEY=
EXCHANGE_API_SECRET=

# Nautilus Parquet catalog of public Binance ETH/USDT klines (research only).
CATALOG_PATH=catalog
# Comma-separated extra catalog directories for multi-interval data (one dir per interval).
CATALOG_PATHS=
BAR_INTERVAL=1h
BINANCE_SYMBOL=ETHUSDT
# Comma-separated symbols for multi-instrument ingest (BTCUSDT,ETHUSDT)
BINANCE_SYMBOLS=["ETHUSDT","BTCUSDT"]
EMBARGO_BARS=10
USE_BAR_VPIN=false
MAKER_FEE=0.001
TAKER_FEE=0.001
KELLY_FRACTION=0.25
MAX_VAR_99=0.05
# Optional risk overlays (default off — existing robots unchanged)
USE_VOL_SCALING=false
VOL_SCALING_TARGET=0.02
# Which volatility model feeds USE_VOL_SCALING: har | egarch | gjr_garch.
# har is the default: no extra dependency, refits every bar, and it is the model
# behind every already-documented vol-scaled run. egarch and gjr_garch need the
# 'research' extra and fit by maximum likelihood, so they refit only every
# VOL_REFIT_EVERY bars (reusing the last forecast in between) — doing an MLE fit
# per bar would turn a 3000-bar smoke run into hours. GJR-GARCH adds the
# asymmetry term that makes drawdowns raise variance more than rallies do.
# A model whose package is missing returns no forecast instead of failing the run.
VOL_MODEL=har
VOL_REFIT_EVERY=24
USE_FRACTIONAL_KELLY=false
KELLY_MIN_TRADES=30
USE_CVAR_BREAKER=false
MAX_CVAR_99=0.05
# Deterministic profit ratchet (SignalRobot only). Off by default — robots still
# exit on their own FLAT. When on, a wick through the stop flattens even if the
# strategy stays silent; the floor never loosens.
USE_RATCHET=false
RATCHET_ARM_PCT=0.0125
# Pairs rolling cointegration refit: re-evaluate the pair every N bars and close the
# position when it stops being cointegrated. 0 = freeze beta after the first fit.
# The same N is the retry cadence while the gate is closed, so raising it also cuts
# how many ADF fits a run performs.
PAIRS_REFIT_EVERY=0
# Pairs entry gate as an empirical quantile of the fitted spread window instead of a
# fixed z_entry. 0 = off (fixed z_entry, the configuration docs/05 §4 was measured
# under). A probability p in (0, 0.5) enters long at quantile p and short at 1 - p,
# and z_entry is then ignored. Fat-tailed spreads put the quantile further out than
# the 1.96 sigma a normal assumption implies, so the gate stops firing on moves that
# are ordinary for that distribution. Fix this before the OOS run, never on it.
PAIRS_Z_ENTRY_QUANTILE=0
# VPIN momentum robot
VPIN_MOMENTUM_EMA_PERIOD=50
VPIN_MOMENTUM_ATR_MULTIPLE=2
# Formulaic LightGBM robot (train offline with scripts/train_formulaic_lgbm.py)
FORMULAIC_MODEL_PATH=
FORMULAIC_THRESHOLD=0.55
# Meta-label robot: gates regime entries (train offline with scripts/train_meta_label.py)
META_LABEL_MODEL_PATH=
META_LABEL_THRESHOLD=0.55
# Optional alerts (Telegram or webhook for Slack/Discord)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
ALERT_WEBHOOK_URL=

# Offline alpha-proposal loop (`lab propose`, scripts/propose_alphas.py) — research only.
# Leave LLM_API_KEY empty to keep the loop disabled and fail closed.
# Any OpenAI-compatible endpoint works: DeepSeek, a corporate gateway, or a local
# open-weights server (vLLM/Ollama) at http://127.0.0.1:11434/v1.
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat
LLM_TEMPERATURE=0.2
LLM_TIMEOUT_SECONDS=120
LLM_PROMPTS_DIR=research/prompts
LLM_HYPOTHESES_DIR=research/hypotheses

# Append-only research journal: human table + journal.jsonl machine log.
# Off by default; `--journal` on `lab research` / `lab propose` appends regardless.
JOURNAL_ENABLED=false
JOURNAL_PATH=research/journal.md
JOURNAL_JSONL_PATH=research/journal.jsonl
