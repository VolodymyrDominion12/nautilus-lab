# deploy/.env — read by docker compose itself (not by the app; the app reads ../.env).

# Where the dashboard listens. Docker publishes around the firewall, so this matters.
#   Tailscale only (recommended): the server's Tailscale IP, e.g. 100.101.102.103
#   Public domain:                0.0.0.0
BIND_ADDR=127.0.0.1

# :80 = plain HTTP (fine behind Tailscale). A domain name = automatic HTTPS.
SITE_ADDRESS=:80

# Same value as API_TOKEN in ../.env (compiled into the dashboard bundle).
API_TOKEN=

# Lock for a dashboard reachable beyond localhost/Tailscale (BIND_ADDR=0.0.0.0 or a
# public IP). deploy_vps.sh refuses such a deploy while this is off. Hash:
#   docker run --rm caddy:2-alpine caddy hash-password
# and keep it in SINGLE quotes — it contains `$`, which compose would expand.
DASHBOARD_AUTH=off
BASIC_AUTH_USER=
BASIC_AUTH_HASH=''

# Container user/group IDs (match host user who owns data/, reports/, catalog/).
# Default is 1001 (typical for second user on VPS, e.g. adduser lab). Use 1000 if needed.
APP_UID=1001
APP_GID=1001

# Dashboard Content-Security-Policy (deploy/Caddyfile). Report-Only blocks nothing and
# logs violations in the browser console; switch to enforcing once the console is clean:
#   CSP_MODE=Content-Security-Policy
CSP_MODE=Content-Security-Policy-Report-Only

# Memory limits per container (docker-compose.yml). Raise API_MEM_LIMIT if many sessions.
API_MEM_LIMIT=1536m
COLLECTOR_MEM_LIMIT=768m
WEB_MEM_LIMIT=256m
BACKUP_MEM_LIMIT=1g

# Optional services: collector = tick collector, backup = off-server restic backup.
#   COMPOSE_PROFILES=collector,backup
COMPOSE_PROFILES=collector
TICK_SYMBOLS=ETHUSDT
TICK_WINDOW_MINUTES=60

# Off-server backup (profile "backup", deploy/backup.sh, docs/26 §7). The repository must
# live somewhere else than this VPS. Examples:
#   s3:https://s3.eu-central-1.amazonaws.com/<bucket>/nautilus-lab   (+ AWS_* keys)
#   b2:<bucket>:nautilus-lab                                         (+ B2_* keys)
#   rest:https://user:pass@backup.example.com/nautilus-lab           (restic rest-server)
# RESTIC_PASSWORD encrypts the repository: keep a copy OFF the server, or the backup
# cannot be restored when the server is gone. Single quotes if it contains `$`.
RESTIC_REPOSITORY=
RESTIC_PASSWORD=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
B2_ACCOUNT_ID=
B2_ACCOUNT_KEY=
BACKUP_EVERY_SECONDS=3600
# Optional: pinged after every successful backup (a separate check from the API's).
BACKUP_HEARTBEAT_URL=

