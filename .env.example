# Default is research/backtest. Never put real keys in git.
TRADING_MODE=research
LIVE_ENABLED=false

# Starting simulated equity for research backtests (quote currency).
STARTING_EQUITY=100000

# Risk limits (fractions of equity). Override only with intent.
RISK_PER_TRADE=0.005
STOP_PCT=0.03
ATR_STOP_MULTIPLIER=2
MAX_DAILY_LOSS=0.04
MAX_DRAWDOWN=0.12
MAX_OPEN_POSITIONS=1

# regime | ema | pairs | vpin_momentum | formulaic_lgbm | meta_label | adaptive_ema
ROBOT=regime

# EMA robot (used when ROBOT=ema).
FAST_EMA=10
SLOW_EMA=20
# Deadband: min relative distance (|fast - slow| / slow) to enter or reverse (0 = off).
EMA_MIN_SPREAD_PCT=0

# Regime classifier (Kaufman ER + EMA slope) and per-regime strategies.
ER_PERIOD=20
TREND_EMA_PERIOD=40
SLOPE_LOOKBACK=10
ENTER_TREND_ER=0.30
EXIT_TREND_ER=0.20
DONCHIAN_PERIOD=20
BB_PERIOD=20
BB_K=2
REGIME_CONFIRMATION_BARS=1
# false = range leg never shorts the upper band (take profit only). Hypothesis H3.
REGIME_RANGE_ALLOW_SHORT=true
REGIME_MIN_HOLD_BARS=0
# Entry gates (domain/entry_filters.py), all off by default. Hypotheses H1/H2/H4.
ENTRY_FILTER_HTF_TREND=false
ENTRY_FILTER_HTF_EMA_PERIOD=200
ENTRY_FILTER_HTF_SLOPE_LOOKBACK=24
ENTRY_FILTER_VOL_EXPANSION=false
ENTRY_FILTER_VOL_FAST_PERIOD=24
ENTRY_FILTER_VOL_SLOW_PERIOD=300
ENTRY_FILTER_MIN_VOL_RATIO=1
# Global-trend gate (domain/global_trend.py), off by default: no new entry against the
# MA of completed higher-timeframe closes. 1d/200/sma = the classic "price vs 200-day
# SMA" bull/bear line; BAND_PCT is a hysteresis zone (inside it the last state holds).
# WARMUP: allow = entries pass until the MA is ready, block = no entries until then.
ENTRY_FILTER_GLOBAL_TREND=false
ENTRY_FILTER_GLOBAL_TREND_TIMEFRAME=1d
ENTRY_FILTER_GLOBAL_TREND_PERIOD=200
ENTRY_FILTER_GLOBAL_TREND_MA=sma
ENTRY_FILTER_GLOBAL_TREND_BAND_PCT=0.02
ENTRY_FILTER_GLOBAL_TREND_WARMUP=allow
NO_INSTANT_REVERSE=false
# 0 = orders fill at the decision bar's close; 50 = old behaviour (one bar late).
BACKTEST_FILL_LATENCY_MS=0

# adaptive_ema robot: the regime filter's EMA step depends on the efficiency ratio.
# ADAPTIVE_SELECTIVITY=0 disables that (α becomes constant = the `regime` filter), so
# the grid {10,20,40} x {0,0.5,1} contains its own control.
ADAPTIVE_PERIOD=40
ADAPTIVE_ER_PERIOD=20
ADAPTIVE_SELECTIVITY=0.5
ADAPTIVE_SLOPE_LOOKBACK=10
ADAPTIVE_RANGE_ALLOW_SHORT=false
ADAPTIVE_RANGE_EXIT_AT_MEAN=false
ADAPTIVE_MIN_BB_WIDTH_PCT=0
ADAPTIVE_HOLD_TREND_IN_RANGE=true

# Funding rate cash-and-carry robot (used when ROBOT=funding).
# Spot long + perp short delta-neutral carry when funding exceeds round-trip costs.
FUNDING_MIN_NET_APY=0.10
FUNDING_HOLDING_PERIODS=60
FUNDING_BASIS_MAX=0.005
FUNDING_CLOSE_ON_NEGATIVE=false
# Both are optional (None = disabled). Keep them COMMENTED OUT: an empty value cannot be
# parsed into `Decimal | None` / `int | None`, so `FUNDING_MIN_EXIT_APY=` would make every
# Settings load raise and `cp .env.example .env` would produce an unusable config.
# To set one, uncomment it AND give it a number.
# FUNDING_MIN_EXIT_APY=
FUNDING_MIN_HOLDING_PERIODS=15
# FUNDING_MAX_HOLDING_PERIODS=
FUNDING_SPOT_ID=ETH/USDT.SIM
FUNDING_PERP_ID=ETHUSDT-PERP.SIM

# Leave empty. Live execution is not wired and will fail closed.
EXCHANGE_API_KEY=
EXCHANGE_API_SECRET=

# Nautilus Parquet catalog of public Binance ETH/USDT klines (research only).
CATALOG_PATH=catalog
# Comma-separated extra catalog directories for multi-interval data (one dir per interval).
CATALOG_PATHS=
BAR_INTERVAL=1h
# Simulation instrument the catalog series is written for. Changing it (or BAR_INTERVAL)
# means a NEW ingest: the `-1-HOUR-` and `-5-MINUTE-` series are different data sets.
INSTRUMENT_ID=ETH/USDT.SIM
# Derived Nautilus bar type. Only meaningful together with INSTRUMENT_ID + BAR_INTERVAL;
# e.g. ETH/USDT.SIM-1-HOUR-LAST-EXTERNAL.
BAR_TYPE=ETH/USDT.SIM-1-MINUTE-LAST-EXTERNAL
BINANCE_SYMBOL=ETHUSDT
# Comma-separated symbols for multi-instrument ingest (BTCUSDT,ETHUSDT).
# Every *USDT ticker is accepted here, but ingest only works for symbols that have
# an instrument description in infrastructure/nautilus/instrument.py — otherwise
# `lab ingest` stops with "unsupported instrument_id" and the earlier symbols in
# the list are already written. See docs/11 for the current list.
BINANCE_SYMBOLS=["ETHUSDT","BTCUSDT"]
EMBARGO_BARS=10
USE_BAR_VPIN=false
# Tick-level filters. Both need a real aggTrades series in the catalog
# (`lab ingest --trades`); WITHOUT it the engine reads the missing series as an EMPTY
# one, so the run looks tick-filtered while the filter has nothing to compute on.
# `--bar-vpin` (the flag above) is the weaker bar-volume proxy and needs no ticks.
# Which robots honour them: tick VPIN — regime, meta_label, vpin_momentum;
# Hawkes — regime, meta_label. On any other robot the flag changes nothing.
USE_TICK_VPIN=false
USE_HAWKES=false
# Hawkes self-exciting intensity: baseline, excitation alpha, decay beta and the
# threshold above which the flow counts as toxic (alpha/beta is the branching ratio).
HAWKES_BASELINE=0.1
HAWKES_ALPHA=0.5
HAWKES_BETA=1.0
HAWKES_TOXIC_THRESHOLD=2.0
# VPIN bucket volume, in base-currency units. There is no universally correct value:
# it depends on the instrument and the timeframe (see docs/08 §1.2). Kept manual on
# purpose — fitting it would turn the toxicity feature itself into a fitted parameter.
VPIN_BUCKET_VOLUME=1000
VPIN_TOXIC_THRESHOLD=0.7
# IS-гіпотеза «перцентильний поріг»: замість фіксованого VPIN_TOXIC_THRESHOLD=0.7
# (недосяжного на 1h-барах: max реального VPIN ≈ 0.694) вмикається rolling-квантиль.
# Активний ЛИШЕ для robot=vpin_momentum; всі інші роботи ігнорують ці параметри.
# Правило: VPIN_QUANTILE підбирається ТІЛЬКИ на IS. OOS = фіксований.
# false = стара поведінка (BarVpin з VPIN_TOXIC_THRESHOLD).
USE_QUANTILE_VPIN=false
# Перцентиль rolling-розподілу VPIN. Рекомендована IS-сітка: 0.85/0.90/0.95.
VPIN_QUANTILE=0.90
# Enabled legs of regime / adaptive_ema (and meta_label's primary): any of
# uptrend,downtrend,range. Empty = all. A disabled leg's entries are dropped and logged
# as filter.regime_legs; its exits still pass. For batch hypotheses, e.g. "uptrend,range".
REGIME_LEGS=
# Cost scenario, by name (domain/fees.py::COST_PROFILES): binance_vip0_bnb (the tariff the
# account actually has), binance_vip0_no_bnb, stress_x1_5 (base x1.5, standing in for
# slippage beyond the fill model). When set, it OVERRIDES the four fee fields below, and the
# name is recorded in every run manifest (`cost=...`), so an artefact says which costs it
# paid. Empty = use the fee fields as written. An unknown name fails the run on purpose.
COST_PROFILE=
SPOT_MAKER_FEE=0.00075
SPOT_TAKER_FEE=0.00075
USDM_MAKER_FEE=0.0002
USDM_TAKER_FEE=0.0005
KELLY_FRACTION=0.25
MAX_VAR_99=0.05
# Optional risk overlays (default off — existing robots unchanged)
USE_VOL_SCALING=false
VOL_SCALING_TARGET=0.02
# Which volatility model feeds USE_VOL_SCALING: har | egarch | gjr_garch.
# har is the default: no extra dependency, refits every bar, and it is the model
# behind every already-documented vol-scaled run. egarch and gjr_garch need the
# 'research' extra and fit by maximum likelihood, so they refit only every
# VOL_REFIT_EVERY bars (reusing the last forecast in between) — doing an MLE fit
# per bar would turn a 3000-bar smoke run into hours. GJR-GARCH adds the
# asymmetry term that makes drawdowns raise variance more than rallies do.
# A model whose package is missing returns no forecast instead of failing the run.
VOL_MODEL=har
VOL_REFIT_EVERY=24
USE_FRACTIONAL_KELLY=false
KELLY_MIN_TRADES=30
USE_CVAR_BREAKER=false
MAX_CVAR_99=0.05
# Deterministic profit ratchet (SignalRobot only). Off by default — robots still
# exit on their own FLAT. When on, a wick through the stop flattens even if the
# strategy stays silent; the floor never loosens.
USE_RATCHET=false
RATCHET_ARM_PCT=0.0125
# Resting reduce-only stop order after every SignalRobot entry, placed at the same
# distance the position was sized against (STOP_PCT, or 2x ATR once ATR is warm).
# On by default: without it RISK_PER_TRADE only sizes the trade and nothing caps the
# loss of a position the strategy never exits. false = the pre-2026-09-23 behaviour.
USE_PROTECTIVE_STOP=true
# Chandelier Exit (volatility-adaptive trailing stop, Chuck LeBeau).
# Off by default. When on, sizes entry and trails stop at highest high / lowest low
# over CHANDELIER_LOOKBACK bars offset by CHANDELIER_ATR_MULTIPLIER * ATR.
# The stop never loosens and dynamically updates the resting venue protective stop.
USE_CHANDELIER_STOP=false
CHANDELIER_ATR_MULTIPLIER=3.0
CHANDELIER_LOOKBACK=22
# What in-sample parameter selection maximises: pnl (ending balance minus a turnover
# haircut; favours whichever candidate took the most risk), sharpe (per-bar Sharpe of
# the marked equity curve) or calmar (return over max drawdown, dd floored at 0.5%).
SELECTION_METRIC=pnl
# Days after which a tripped max-drawdown breaker re-bases its peak to current equity
# and lets entries resume. 0 = blocked for the rest of the run (the old behaviour);
# then an out-of-sample result measures the breaker more than the signal.
DRAWDOWN_COOLDOWN_DAYS=0
# During research runs, the breaker acts as a fast cooldown to prevent wiping out the
# backtest in prolonged bad regimes, allowing the signal to be measured again sooner.
RESEARCH_DRAWDOWN_COOLDOWN_DAYS=7
# Pairs rolling cointegration refit: re-evaluate the pair every N bars and close the
# position when it stops being cointegrated. 0 = freeze beta after the first fit.
# The same N is the retry cadence while the gate is closed, so raising it also cuts
# how many ADF fits a run performs.
# Legs of `pairs`: A is traded in the spread's direction, B hedges it.
PAIRS_LEG_A=ETH/USDT.SIM
PAIRS_LEG_B=BTC/USDT.SIM
PAIRS_REFIT_EVERY=48
# Pairs entry gate as an empirical quantile of the fitted spread window instead of a
# fixed z_entry. 0 = off (fixed z_entry, the configuration docs/05 §4 was measured
# under). A probability p in (0, 0.5) enters long at quantile p and short at 1 - p,
# and z_entry is then ignored. Fat-tailed spreads put the quantile further out than
# the 1.96 sigma a normal assumption implies, so the gate stops firing on moves that
# are ordinary for that distribution. Fix this before the OOS run, never on it.
PAIRS_Z_ENTRY_QUANTILE=0
# VPIN momentum robot
VPIN_MOMENTUM_EMA_PERIOD=50
VPIN_MOMENTUM_ATR_MULTIPLE=2
# Formulaic LightGBM robot (train offline with scripts/train_formulaic_lgbm.py).
# Leave empty and the robot fails closed with a clear message rather than silently
# falling back to the heuristic classifier and reporting a run it did not do.
FORMULAIC_MODEL_PATH=
FORMULAIC_THRESHOLD=0.55
FORMULAIC_MIN_HOLD_BARS=0
# Meta-label robot: gates regime entries (train offline with scripts/train_meta_label.py,
# or `lab ml train --model-type meta_label`). Example: META_LABEL_MODEL_PATH=models/meta_label.txt
# Without it `lab paper --robot meta_label` refuses to run (fail closed by design):
# the paper ledger would otherwise describe a robot that was never loaded.
META_LABEL_MODEL_PATH=
META_LABEL_THRESHOLD=0.55
# Order-book-imbalance robot (train offline with `lab ml train --model-type obi`).
# It also needs an L2 series in the catalog (`lab ingest --depth`); without a model the
# robot fails closed instead of running on an untrained classifier.
ML_OBI_MODEL_PATH=
ML_OBI_THRESHOLD=0.55
# Optional alerts (Telegram or webhook for Slack/Discord)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
ALERT_WEBHOOK_URL=

# Offline alpha-proposal loop (`lab propose`, scripts/propose_alphas.py) — research only.
# Leave LLM_API_KEY empty to keep the loop disabled and fail closed.
# Any OpenAI-compatible endpoint works: DeepSeek, a corporate gateway, or a local
# open-weights server (vLLM/Ollama) at http://127.0.0.1:11434/v1.
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat
LLM_TEMPERATURE=0.2
LLM_TIMEOUT_SECONDS=120
LLM_PROMPTS_DIR=research/prompts
LLM_HYPOTHESES_DIR=research/hypotheses

# Append-only research journal: human table + journal.jsonl machine log.
# Off by default; `--journal` on `lab research` / `lab propose` appends regardless.
JOURNAL_ENABLED=false
JOURNAL_PATH=research/journal.md
JOURNAL_JSONL_PATH=research/journal.jsonl

# Backtest Leaderboard: human markdown table + leaderboard.jsonl machine log.
# Off by default; `--leaderboard` on `lab research` appends regardless.
LEADERBOARD_ENABLED=false
LEADERBOARD_PATH=research/leaderboard.md
LEADERBOARD_JSONL_PATH=research/leaderboard.jsonl

# Dashboard API gate (src/nautilus_lab/api/security.py). A browser request that
# carries an Origin must come from one of these; empty = Vite dev/preview
# (:5173, :4173) and the API itself (:8000). Comma-separated, no trailing slash.
API_ALLOWED_ORIGINS=
# Optional shared secret. When set, every /api call needs the header X-Lab-Token
# (the dashboard sends VITE_API_TOKEN from frontend/.env). Restart the API to change.
API_TOKEN=

# Deployment role (src/nautilus_lab/api/security.py). full = research workstation.
# paper = a server (VPS) that only runs the live paper terminal: research, ingest, ML,
# alpha proposals and PUT /api/settings are refused. Unknown values refuse to start.
LAB_ROLE=full

# Live paper terminal persistence (infrastructure/live_paper_journal.py). Empty = the
# ledger lives in memory and is lost on restart. When set, every fill and closed bar is
# appended there and an unfinished session is resumed when the API starts.
# Example: LIVE_PAPER_JOURNAL=data/paper/live_events.jsonl
LIVE_PAPER_JOURNAL=
# Start a session on API start when the journal has nothing to resume. Robot params,
# fees, RISK_PER_TRADE, STOP_PCT and the breakers come from the settings above.
LIVE_PAPER_AUTOSTART=false
LIVE_PAPER_SYMBOL=ETHUSDT
LIVE_PAPER_INTERVAL=1h
LIVE_PAPER_ROBOT=regime
LIVE_PAPER_STARTING_EQUITY=10000
LIVE_PAPER_TAKE_PROFIT_MULTIPLE=2
# Several sessions (api/live_sessions.py). A YAML portfolio replaces the single autostart
# session above: deploy/paper_portfolio.yaml. Journals: one file per session in
# LIVE_PAPER_SESSIONS_DIR (empty = `sessions/` next to LIVE_PAPER_JOURNAL).
LIVE_PAPER_PORTFOLIO=
LIVE_PAPER_SESSIONS_DIR=
LIVE_PAPER_MAX_SESSIONS=8
LIVE_PAPER_MAX_FEEDS=5
# Liveness (api/health.py): /readyz turns 503 and the watchdog alerts (TELEGRAM_*/
# ALERT_WEBHOOK_URL) when a feed is silent this long, or its closed bar is later than
# interval + slack. LIVE_PAPER_WATCHDOG_SECONDS=0 turns the watchdog off.
LIVE_PAPER_FEED_TIMEOUT_SECONDS=90
LIVE_PAPER_CLOSED_BAR_SLACK_SECONDS=180
LIVE_PAPER_FEED_GRACE_SECONDS=120
LIVE_PAPER_WATCHDOG_SECONDS=30
# Dead-man's switch (push check URL; pinged while ready; needs the watchdog on).
LIVE_PAPER_HEARTBEAT_URL=
LIVE_PAPER_HEARTBEAT_FAIL_URL=
LIVE_PAPER_HEARTBEAT_SECONDS=300


DECISION_LOG_ENABLED=true
DECISION_LOG_DIR=data/paper/decisions
# Days a log file lives from when it was WRITTEN (not from the bar date in its name:
# a backtest over history writes 2024-01-01 files today). 0 keeps them forever.
DECISION_LOG_RETENTION_DAYS=7
# Max total directory size in megabytes (0 disables size quota). Oldest files are deleted first.
DECISION_LOG_MAX_MB=500
# Walk-forward: "all" logs every in-sample grid run too; "oos" logs only each fold's
# out-of-sample run, under <session>-f<fold> (batch backtests always use "oos").
DECISION_LOG_SCOPE=oos
# Walk-forward in-sample grid in parallel processes (same results, less wall time).
# 1 = serial, 0 = all cores but one. A batch sets it per cell from --cpu-budget.
BACKTEST_IS_WORKERS=1
# false = no in-sample search: each fold runs the configured parameters (1 trial, not 15).
PARAM_SEARCH=true

TRIALS_LEDGER_PATH=research/trials.jsonl
# Registered test terms, one JSON file each (docs/27 R-2): `lab research --register`.
PREREGISTRATIONS_DIR=research/preregistrations

