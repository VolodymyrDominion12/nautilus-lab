# ../.env on the VPS — the app's settings. Copy from here, not from the workstation:
# the workstation .env holds keys (LLM, alerts) this server has no use for.

# Only the live paper terminal runs here; research/ingest/ML/settings writes are refused.
LAB_ROLE=paper
TRADING_MODE=paper
LIVE_ENABLED=false
EXCHANGE_API_KEY=
EXCHANGE_API_SECRET=

# The ledger survives deploys and reboots; unfinished sessions resume on start.
# One journal per session goes to data/paper/sessions/ (next to this file).
LIVE_PAPER_JOURNAL=data/paper/live_events.jsonl
# Sessions to run, reconciled by name on every start (see the file's header).
# When set, it replaces LIVE_PAPER_AUTOSTART and the LIVE_PAPER_ROBOT/SYMBOL/INTERVAL below.
LIVE_PAPER_PORTFOLIO=deploy/paper_portfolio.yaml
LIVE_PAPER_MAX_SESSIONS=8
LIVE_PAPER_MAX_FEEDS=5
LIVE_PAPER_AUTOSTART=true
LIVE_PAPER_SYMBOL=ETHUSDT
LIVE_PAPER_INTERVAL=1h
# Live terminal robots: regime | ema | adaptive_ema | vpin_momentum | formulaic_lgbm
LIVE_PAPER_ROBOT=regime
LIVE_PAPER_STARTING_EQUITY=10000
LIVE_PAPER_TAKE_PROFIT_MULTIPLE=2

# Frozen research configuration the robot trades with. Copy these values from the
# workstation run you want to rehearse, and change them only by redeploying.
RISK_PER_TRADE=0.005
STOP_PCT=0.01
MAX_DAILY_LOSS=0.02
MAX_DRAWDOWN=0.06
MAKER_FEE=0.001
TAKER_FEE=0.001
FAST_EMA=10
SLOW_EMA=20
ER_PERIOD=20
TREND_EMA_PERIOD=40
SLOPE_LOOKBACK=10
ENTER_TREND_ER=0.30
EXIT_TREND_ER=0.20
DONCHIAN_PERIOD=20
BB_PERIOD=20
BB_K=2

# Dashboard gate. Origin = exactly how you open the dashboard in the browser:
#   http://100.101.102.103  (Tailscale IP)   or   https://lab.example.com
API_ALLOWED_ORIGINS=http://100.101.102.103
# Long random string: openssl rand -hex 32   (same value in deploy/.env API_TOKEN)
API_TOKEN=

# Tick collector writes here (catalog/data/agg_trade/<SYMBOL>/<day>.parquet).
CATALOG_PATH=catalog

# Alerts: the watchdog (api/health.py) sends a message when a feed goes silent, a
# session's journal stops writing or a circuit breaker trips, and again on recovery;
# plus one message per start. Strongly recommended for a server nobody watches.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
LIVE_PAPER_WATCHDOG_SECONDS=30
LIVE_PAPER_FEED_TIMEOUT_SECONDS=90
# Dead-man's switch: a push check (healthchecks.io, Uptime Kuma "push"). Pinged every
# HEARTBEAT_SECONDS while /readyz is green; the service alarms when pings stop - the
# only alert that still works when this VPS itself is down. Period ~5 min, grace ~10.
LIVE_PAPER_HEARTBEAT_URL=
LIVE_PAPER_HEARTBEAT_FAIL_URL=
LIVE_PAPER_HEARTBEAT_SECONDS=300

# Decision Log for Live Paper API (persisted to writable data volume)
DECISION_LOG_ENABLED=true
DECISION_LOG_DIR=data/paper/decisions
DECISION_LOG_RETENTION_DAYS=7
